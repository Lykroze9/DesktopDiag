{
  "version": 1,
  "scoring": { "start": 100, "yellow": 8, "red": 18, "min": 0 },
  "areas": [
    {
      "id": "stability",
      "label": { "fr": "Stabilité", "en": "Stability" },
      "rules": [
        { "id": "crash.recent", "level": "red", "when": { "fact": "crashes7d", "op": ">=", "value": 1 },
          "text": { "fr": "{crashes7d} plantage(s) ou arrêt(s) brutal(aux) ces 7 derniers jours", "en": "{crashes7d} crash(es) or sudden shutdown(s) in the last 7 days" } },
        { "id": "crash.many", "level": "red", "when": { "fact": "crashes30d", "op": ">=", "value": 3 },
          "text": { "fr": "{crashes30d} plantages ou arrêts brutaux en 30 jours", "en": "{crashes30d} crashes or sudden shutdowns in 30 days" } },
        { "id": "crash.some", "level": "yellow", "when": { "fact": "crashes30d", "op": ">=", "value": 1 },
          "text": { "fr": "{crashes30d} plantage(s) ou arrêt(s) brutal(aux) en 30 jours", "en": "{crashes30d} crash(es) or sudden shutdown(s) in 30 days" } },
        { "id": "reliability.low", "level": "yellow", "when": { "fact": "reliabilityIndex", "op": "<", "value": 5 },
          "text": { "fr": "Indice de fiabilité Windows bas ({reliabilityIndex}/10)", "en": "Low Windows reliability index ({reliabilityIndex}/10)" } }
      ]
    },
    {
      "id": "graphics",
      "label": { "fr": "Carte graphique", "en": "Graphics" },
      "rules": [
        { "id": "gpu.errors.many", "level": "red", "when": { "fact": "gpuErrors30d", "op": ">=", "value": 3 },
          "text": { "fr": "{gpuErrors30d} erreurs ou réinitialisations du pilote graphique en 30 jours", "en": "{gpuErrors30d} graphics driver errors or resets in 30 days" } },
        { "id": "gpu.code43", "level": "red", "when": { "fact": "gpuDeviceError", "op": "==", "value": true },
          "text": { "fr": "La carte graphique est en erreur dans le Gestionnaire de périphériques", "en": "The graphics card is in error in Device Manager" } },
        { "id": "gpu.errors.some", "level": "yellow", "when": { "fact": "gpuErrors30d", "op": ">=", "value": 1 },
          "text": { "fr": "{gpuErrors30d} erreur(s) du pilote graphique en 30 jours", "en": "{gpuErrors30d} graphics driver error(s) in 30 days" } },
        { "id": "gpu.driver.old", "level": "yellow", "when": { "fact": "gpuDriverAgeDays", "op": ">", "value": 365 },
          "text": { "fr": "Pilote graphique ancien ({gpuDriverAgeDays} jours)", "en": "Old graphics driver ({gpuDriverAgeDays} days)" } }
      ]
    },
    {
      "id": "storageSpace",
      "label": { "fr": "Espace disque", "en": "Storage space" },
      "rules": [
        { "id": "space.system.critical", "level": "red", "when": { "any": [ { "fact": "systemFreePct", "op": "<", "value": 8 }, { "fact": "systemFreeGB", "op": "<", "value": 15 } ] },
          "text": { "fr": "Disque système presque plein : {systemFreeGB} Go libres ({systemFreePct} %)", "en": "System drive almost full: {systemFreeGB} GB free ({systemFreePct}%)" } },
        { "id": "space.system.low", "level": "yellow", "when": { "any": [ { "fact": "systemFreePct", "op": "<", "value": 15 }, { "fact": "systemFreeGB", "op": "<", "value": 30 } ] },
          "text": { "fr": "Peu d'espace sur le disque système : {systemFreeGB} Go libres ({systemFreePct} %)", "en": "Low space on the system drive: {systemFreeGB} GB free ({systemFreePct}%)" } },
        { "id": "space.data.low", "level": "yellow", "when": { "fact": "dataMinFreePct", "op": "<", "value": 10 },
          "text": { "fr": "Un disque de données a moins de 10 % libres ({dataMinFreePct} %)", "en": "A data drive has less than 10% free ({dataMinFreePct}%)" } }
      ]
    },
    {
      "id": "diskHealth",
      "label": { "fr": "Santé des disques", "en": "Disk health" },
      "rules": [
        { "id": "disk.unhealthy", "level": "red", "when": { "fact": "diskUnhealthy", "op": "==", "value": true },
          "text": { "fr": "Windows signale un disque en mauvaise santé", "en": "Windows reports an unhealthy disk" } },
        { "id": "disk.smart.failed", "level": "red", "when": { "fact": "smartFailed", "op": "==", "value": true },
          "text": { "fr": "Un disque échoue au test SMART", "en": "A disk fails its SMART check" } },
        { "id": "disk.media.errors", "level": "red", "when": { "fact": "smartMediaErrors", "op": ">", "value": 0 },
          "text": { "fr": "Erreurs de support ou secteurs défectueux détectés ({smartMediaErrors})", "en": "Media errors or bad sectors detected ({smartMediaErrors})" } },
        { "id": "disk.uncorrected", "level": "red", "when": { "fact": "readUncorrected", "op": ">", "value": 0 },
          "text": { "fr": "Erreurs de lecture non corrigées ({readUncorrected})", "en": "Uncorrected read errors ({readUncorrected})" } },
        { "id": "disk.worn.out", "level": "red", "when": { "fact": "maxWearPct", "op": ">=", "value": 100 },
          "text": { "fr": "SSD en fin de vie (usure {maxWearPct} %)", "en": "SSD at end of life ({maxWearPct}% wear)" } },
        { "id": "disk.internal.errors", "level": "red", "when": { "fact": "internalDiskErrors", "op": ">", "value": 0 },
          "text": { "fr": "{internalDiskErrors} erreur(s) graves sur un disque interne", "en": "{internalDiskErrors} serious error(s) on an internal disk" } },
        { "id": "disk.worn", "level": "yellow", "when": { "fact": "maxWearPct", "op": ">=", "value": 80 },
          "text": { "fr": "SSD bien usé ({maxWearPct} %)", "en": "SSD significantly worn ({maxWearPct}%)" } },
        { "id": "disk.hot", "level": "yellow", "when": { "fact": "ssdWarningTempMinutes", "op": ">", "value": 60 },
          "text": { "fr": "Le SSD a passé {ssdWarningTempMinutes} minutes au-dessus de sa température d'alerte", "en": "The SSD spent {ssdWarningTempMinutes} minutes above its warning temperature" } },
        { "id": "disk.retries", "level": "yellow", "when": { "fact": "diskRetries", "op": ">", "value": 0 },
          "text": { "fr": "{diskRetries} accès disque à répéter en 30 jours (souvent un disque USB)", "en": "{diskRetries} disk access retries in 30 days (often a USB drive)" } }
      ]
    },
    {
      "id": "hardwareErrors",
      "label": { "fr": "Matériel", "en": "Hardware" },
      "rules": [
        { "id": "whea.fatal", "level": "red", "when": { "fact": "wheaFatal", "op": ">", "value": 0 },
          "text": { "fr": "Erreur matérielle fatale (WHEA)", "en": "Fatal hardware error (WHEA)" } },
        { "id": "whea.many", "level": "red", "when": { "fact": "wheaCorrected", "op": ">", "value": 10 },
          "text": { "fr": "{wheaCorrected} erreurs matérielles corrigées", "en": "{wheaCorrected} corrected hardware errors" } },
        { "id": "ram.test.failed", "level": "red", "when": { "fact": "ramTestErrors", "op": "==", "value": true },
          "text": { "fr": "Le test mémoire de Windows a trouvé des erreurs dans la RAM", "en": "Windows Memory Diagnostic found RAM errors" } },
        { "id": "device.key.error", "level": "red", "when": { "fact": "keyDeviceErrors", "op": ">", "value": 0 },
          "text": { "fr": "Un périphérique important est en erreur ({keyDeviceErrors})", "en": "A key device is in error ({keyDeviceErrors})" } },
        { "id": "whea.some", "level": "yellow", "when": { "fact": "wheaCorrected", "op": ">", "value": 0 },
          "text": { "fr": "{wheaCorrected} erreur(s) matérielle(s) corrigée(s)", "en": "{wheaCorrected} corrected hardware error(s)" } },
        { "id": "tpm.errors", "level": "yellow", "when": { "fact": "tpmErrors", "op": ">", "value": 0 },
          "text": { "fr": "{tpmErrors} erreur(s) TPM", "en": "{tpmErrors} TPM error(s)" } },
        { "id": "device.other.error", "level": "yellow", "when": { "fact": "otherDeviceErrors", "op": ">", "value": 0 },
          "text": { "fr": "{otherDeviceErrors} périphérique(s) en erreur", "en": "{otherDeviceErrors} device(s) in error" } }
      ]
    },
    {
      "id": "security",
      "label": { "fr": "Sécurité", "en": "Security" },
      "rules": [
        { "id": "av.none", "level": "red", "when": { "fact": "antivirusActive", "op": "==", "value": false },
          "text": { "fr": "Aucun antivirus actif", "en": "No active antivirus" } },
        { "id": "av.realtime.off", "level": "red", "when": { "fact": "realTimeOff", "op": "==", "value": true },
          "text": { "fr": "Protection en temps réel désactivée", "en": "Real-time protection is off" } },
        { "id": "firewall.off", "level": "red", "when": { "fact": "firewallOff", "op": ">", "value": 0 },
          "text": { "fr": "{firewallOff} profil(s) du pare-feu désactivé(s)", "en": "{firewallOff} firewall profile(s) off" } },
        { "id": "av.signatures.old", "level": "yellow", "when": { "fact": "signatureAgeDays", "op": ">", "value": 3 },
          "text": { "fr": "Définitions antivirus vieilles de {signatureAgeDays} jours", "en": "Antivirus definitions are {signatureAgeDays} days old" } },
        { "id": "wu.old", "level": "yellow", "when": { "fact": "wuLastSuccessDays", "op": ">", "value": 30 },
          "text": { "fr": "Dernière mise à jour Windows réussie il y a {wuLastSuccessDays} jours", "en": "Last successful Windows Update {wuLastSuccessDays} days ago" } },
        { "id": "wu.failures", "level": "yellow", "when": { "fact": "wuFailures", "op": ">", "value": 0 },
          "text": { "fr": "{wuFailures} échec(s) récent(s) de mise à jour Windows", "en": "{wuFailures} recent Windows Update failure(s)" } },
        { "id": "uac.off", "level": "yellow", "when": { "fact": "uacOff", "op": "==", "value": true },
          "text": { "fr": "Contrôle de compte d'utilisateur (UAC) désactivé", "en": "User Account Control (UAC) is off" } }
      ]
    },
    {
      "id": "performance",
      "label": { "fr": "Performances (maintenant)", "en": "Performance (now)" },
      "rules": [
        { "id": "ram.full", "level": "red", "when": { "any": [ { "fact": "ramUsedPct", "op": ">", "value": 90 }, { "fact": "commitUsedPct", "op": ">", "value": 95 } ] },
          "text": { "fr": "Mémoire saturée (RAM {ramUsedPct} %, engagée {commitUsedPct} %)", "en": "Memory saturated (RAM {ramUsedPct}%, commit {commitUsedPct}%)" } },
        { "id": "ram.high", "level": "yellow", "when": { "any": [ { "fact": "ramUsedPct", "op": ">", "value": 80 }, { "fact": "commitUsedPct", "op": ">", "value": 85 } ] },
          "text": { "fr": "Mémoire bien remplie (RAM {ramUsedPct} %, engagée {commitUsedPct} %)", "en": "Memory quite full (RAM {ramUsedPct}%, commit {commitUsedPct}%)" } },
        { "id": "cpu.hog", "level": "yellow", "when": { "fact": "topProcessCpuPct", "op": ">", "value": 50 },
          "text": { "fr": "Un programme utilise {topProcessCpuPct} % du processeur", "en": "One program uses {topProcessCpuPct}% of the CPU" } }
      ]
    },
    {
      "id": "bootTime",
      "label": { "fr": "Démarrage", "en": "Boot time" },
      "rules": [
        { "id": "boot.very.slow", "level": "red", "when": { "fact": "adminBootSec", "op": ">", "value": 120 },
          "text": { "fr": "Démarrage très long ({adminBootSec} s)", "en": "Very slow boot ({adminBootSec} s)" } },
        { "id": "boot.slow", "level": "yellow", "when": { "fact": "adminBootSec", "op": ">", "value": 60 },
          "text": { "fr": "Démarrage lent ({adminBootSec} s)", "en": "Slow boot ({adminBootSec} s)" } },
        { "id": "boot.firmware.slow", "level": "yellow", "when": { "fact": "firmwareSec", "op": ">", "value": 30 },
          "text": { "fr": "Phase BIOS longue ({firmwareSec} s)", "en": "Long firmware phase ({firmwareSec} s)" } },
        { "id": "boot.slowdown", "level": "yellow", "when": { "fact": "bootSlowdownSec", "op": ">", "value": 10 },
          "text": { "fr": "Un élément ralentit les démarrages d'environ {bootSlowdownSec} s", "en": "Something delays boots by about {bootSlowdownSec} s" } }
      ]
    },
    {
      "id": "heat",
      "label": { "fr": "Chauffe", "en": "Heat" },
      "rules": [
        { "id": "heat.zone.critical", "level": "red", "when": { "fact": "maxThermalZoneC", "op": ">", "value": 95 },
          "text": { "fr": "Zone thermique à {maxThermalZoneC} °C", "en": "Thermal zone at {maxThermalZoneC} °C" } },
        { "id": "heat.throttle.recent", "level": "red", "when": { "all": [ { "fact": "throttle7d", "op": ">=", "value": 1 }, { "fact": "onBattery", "op": "!=", "value": true }, { "fact": "crashes7d", "op": ">=", "value": 1 } ] },
          "text": { "fr": "Processeur bridé par la chaleur cette semaine, avec des plantages", "en": "CPU throttled by heat this week, with crashes" } },
        { "id": "heat.throttle", "level": "yellow", "when": { "all": [ { "fact": "throttle30d", "op": ">=", "value": 1 }, { "fact": "onBattery", "op": "!=", "value": true } ] },
          "text": { "fr": "Processeur bridé {throttle30d} fois en 30 jours (chaleur ou limite de puissance)", "en": "CPU throttled {throttle30d} times in 30 days (heat or power limit)" } },
        { "id": "heat.limited.now", "level": "yellow", "when": { "fact": "perfLimitPct", "op": "<", "value": 100 },
          "text": { "fr": "Processeur limité en ce moment ({perfLimitPct} %)", "en": "CPU limited right now ({perfLimitPct}%)" } },
        { "id": "heat.zone.hot", "level": "yellow", "when": { "fact": "maxThermalZoneC", "op": ">", "value": 85 },
          "text": { "fr": "Zone thermique à {maxThermalZoneC} °C", "en": "Thermal zone at {maxThermalZoneC} °C" } }
      ]
    },
    {
      "id": "network",
      "label": { "fr": "Réseau", "en": "Network" },
      "rules": [
        { "id": "net.dns.down", "level": "red", "when": { "fact": "dnsOk", "op": "==", "value": false },
          "text": { "fr": "La résolution de noms (DNS) ne répond pas", "en": "Name resolution (DNS) is not responding" } },
        { "id": "net.gateway.down", "level": "red", "when": { "fact": "gatewayPingMs", "op": "<", "value": 0 },
          "text": { "fr": "La box/le routeur ne répond pas", "en": "The router does not respond" } },
        { "id": "net.wifi.weak", "level": "yellow", "when": { "fact": "wifiSignalPct", "op": "<", "value": 50 },
          "text": { "fr": "Signal Wi-Fi faible ({wifiSignalPct} %)", "en": "Weak Wi-Fi signal ({wifiSignalPct}%)" } },
        { "id": "net.disconnects", "level": "yellow", "when": { "fact": "disconnects7d", "op": ">=", "value": 5 },
          "text": { "fr": "{disconnects7d} coupures réseau en 7 jours", "en": "{disconnects7d} network drops in 7 days" } },
        { "id": "net.dns.slow", "level": "yellow", "when": { "fact": "dnsMs", "op": ">", "value": 300 },
          "text": { "fr": "DNS lent ({dnsMs} ms)", "en": "Slow DNS ({dnsMs} ms)" } },
        { "id": "net.gateway.slow", "level": "yellow", "when": { "fact": "gatewayPingMs", "op": ">", "value": 50 },
          "text": { "fr": "La box/le routeur répond lentement ({gatewayPingMs} ms)", "en": "The router responds slowly ({gatewayPingMs} ms)" } }
      ]
    },
    {
      "id": "battery",
      "label": { "fr": "Batterie", "en": "Battery" },
      "appliesWhen": { "fact": "isLaptop", "op": "==", "value": true },
      "rules": [
        { "id": "battery.worn.out", "level": "red", "when": { "fact": "batteryHealthPct", "op": "<", "value": 60 },
          "text": { "fr": "Batterie très usée ({batteryHealthPct} % de sa capacité d'origine)", "en": "Battery heavily worn ({batteryHealthPct}% of original capacity)" } },
        { "id": "battery.worn", "level": "yellow", "when": { "fact": "batteryHealthPct", "op": "<", "value": 80 },
          "text": { "fr": "Batterie usée ({batteryHealthPct} % de sa capacité d'origine)", "en": "Battery worn ({batteryHealthPct}% of original capacity)" } }
      ]
    },
    {
      "id": "maintenance",
      "label": { "fr": "Entretien", "en": "Maintenance" },
      "rules": [
        { "id": "maint.reboot.pending", "level": "yellow", "when": { "fact": "rebootPending", "op": "==", "value": true },
          "text": { "fr": "Redémarrage en attente", "en": "Reboot pending" } },
        { "id": "maint.uptime", "level": "yellow", "when": { "fact": "uptimeDays", "op": ">", "value": 14 },
          "text": { "fr": "Pas redémarré depuis {uptimeDays} jours", "en": "Not restarted for {uptimeDays} days" } },
        { "id": "maint.startup", "level": "yellow", "when": { "fact": "startupCount", "op": ">", "value": 15 },
          "text": { "fr": "{startupCount} programmes au démarrage", "en": "{startupCount} startup programs" } },
        { "id": "maint.temp", "level": "yellow", "when": { "fact": "tempGB", "op": ">", "value": 5 },
          "text": { "fr": "{tempGB} Go de fichiers temporaires", "en": "{tempGB} GB of temporary files" } }
      ]
    }
  ]
}
